# Integração Jus.br (Opcional - Requer Client ID próprio para localhost)
# Se não definido, usa 'jusbr' (que só redireciona para jus.br)
# VITE_JUSBR_CLIENT_ID=seu_client_id
# VITE_JUSBR_REDIRECT_URI=http://localhost:5173/auth/jusbr/callback
VITE_JUSBR_CLIENT_ID=jusbr
VITE_JUSBR_REDIRECT_URI=http://localhost:5173/auth/jusbr/callback
VITE_JUSBR_SSO_URL=https://sso.cloud.pje.jus.br/auth/realms/pje
